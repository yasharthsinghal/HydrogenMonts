# ==========================================
# MONTS Hydrogen Storefront Environment
# ==========================================

# ==========================================
# Application / Session
# Required. Used for signed HTTP-only session cookies.
# ==========================================
SESSION_SECRET="your_session_secret_here"

# ==========================================
# Shopify Storefront API
# Required for catalog, product, cart, and storefront data.
# ==========================================
PUBLIC_STORE_DOMAIN="your-shop-name.myshopify.com"
PUBLIC_STOREFRONT_API_TOKEN="your_public_storefront_token_here"
PRIVATE_STOREFRONT_API_TOKEN="your_private_storefront_token_here"
PUBLIC_STOREFRONT_ID=""
SHOP_ID="your-shop-id"

# ==========================================
# Shopify Customer Account API
# Required for Hydrogen customer-account compatibility.
# ==========================================
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID="your_customer_account_client_id"
PUBLIC_CUSTOMER_ACCOUNT_API_URL="https://shopify.com/your-shop-id"

# ==========================================
# Shopify Admin API
# Required for server-side customer writes and COD order creation.
# Use SHOPIFY_ADMIN_API_TOKEN, or SHOPIFY_ADMIN_CLIENT_ID with SHOPIFY_ADMIN_CLIENT_SECRET.
# ==========================================
SHOPIFY_ADMIN_API_VERSION="2025-01"
SHOPIFY_ADMIN_API_TOKEN="shpat_your_admin_access_token_here"
SHOPIFY_ADMIN_CLIENT_ID=""
SHOPIFY_ADMIN_CLIENT_SECRET=""

# ==========================================
# Email Provider
# Required for OTP, COD confirmation, and contact-form email.
# OTP_EMAIL_PROVIDER values: smtp, google_oauth2, console_dev.
# ==========================================
OTP_EMAIL_PROVIDER="smtp"

# Gmail SMTP shared settings. Required when OTP_EMAIL_PROVIDER is smtp or google_oauth2.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your_email@gmail.com"
SMTP_FROM="MONTS <your_email@gmail.com>"

# App-password auth. Required only when OTP_EMAIL_PROVIDER is smtp.
SMTP_PASS="your_gmail_16_digit_app_password"

# OAuth2 auth. Required only when OTP_EMAIL_PROVIDER is google_oauth2.
# OAuth Playground: https://developers.google.com/oauthplayground
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""

# ==========================================
# Contact Form
# Required for /contact submissions.
# ==========================================
CONTACT_EMAIL_RECIPIENT="your_email@gmail.com"

# ==========================================
# Discounts
# Optional. Falls back to PREPAID15 in code when empty.
# ==========================================
PREPAID_DISCOUNT_CODE="PREPAID15"

# ==========================================
# Location Service
# Optional. Falls back to postal_pincode, postalpincode.in, and 5000ms in code when empty.
# ==========================================
LOCATION_PROVIDER="postal_pincode"
LOCATION_API_BASE_URL="https://api.postalpincode.in"
LOCATION_API_TIMEOUT_MS="5000"
